# Configurações AWS (LocalStack)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566

# Configurações do Ollama (IA Local)
# No Docker/Linux use http://localhost:11434
# No Docker Desktop (Windows/Mac) use http://host.docker.internal:11434
OLLAMA_ENDPOINT=http://host.docker.internal:11434
OLLAMA_API_KEY=sua_chave_opcional_aqui

# Modelos de IA (Ollama)
# Modelo principal para análise profunda
PRIMARY_MODEL=gpt-oss:120b-cloud
# Modelo de reserva caso o principal falhe ou esteja lento
FALLBACK_MODEL=deepseek-v3.1:671b-cloud

# GitHub Integration
# Obrigatório para evitar Rate Limit (60 req/h -> 5000 req/h)
# Crie em: https://github.com/settings/tokens (escopo read:user, repo)
GITHUB_TOKEN=seu_github_token_aqui

# Infraestrutura
DYNAMODB_TABLE=genefic-local-metadata
S3_BUCKET_NAME=genefic-local-portfolio-uploads
ENVIRONMENT=local