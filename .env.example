# Configurações AWS (LocalStack)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566

# Configurações da Groq (IA)
GROQ_API_KEY=sua_chave_groq_aqui

# Modelos de IA (Groq)
# Modelo principal para análise profunda
PRIMARY_MODEL=llama-3.3-70b-versatile
# Modelo de reserva caso o principal falhe ou esteja lento
FALLBACK_MODEL=llama-3.1-8b-instant

# GitHub Integration
# Obrigatório para evitar Rate Limit (60 req/h -> 5000 req/h)
# Crie em: https://github.com/settings/tokens (escopo read:user, repo)
GITHUB_TOKEN=seu_github_token_aqui

# Infraestrutura
DYNAMODB_TABLE=genefic-local-metadata
S3_BUCKET_NAME=genefic-local-portfolio-uploads
ENVIRONMENT=local
